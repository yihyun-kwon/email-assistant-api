# =================================================================================================
# 기본 Dockerfile : 코드와 규정집을 이미지에 담고, 패키지는 이미지 안에서 설치한다
# -------------------------------------------------------------------------------------------------
#   docker build -t email-assistant:basic .
# =================================================================================================

# 1. 기반 이미지 : 파이썬 3.14가 설치된 가벼운 리눅스(Debian)
#    이 이미지 위에 아래 명령들의 결과가 한 층(레이어)씩 쌓인다.
FROM python:3.14-slim

# 2. 패키지 설치 도구 : uv가 들어 있는 이미지에서 실행 파일 하나만 가져온다.
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /usr/local/bin/uv

# 3. print 로그를 모아 두지 않고 바로 출력한다. (docker logs에서 바로 보인다)
ENV PYTHONUNBUFFERED=1

# 4. 작업 폴더 : 이후의 명령은 컨테이너 안의 /app에서 실행된다. 폴더가 없으면 만든다.
WORKDIR /app

# 5. 패키지 목록을 코드보다 먼저 복사해 설치한다.
#    코드만 바뀌었을 때는 이 층을 재사용하므로 패키지를 다시 설치하지 않는다.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-cache

# 6. 이 PC의 서버 코드와 규정집을 이미지 안으로 복사한다. (이 PC의 경로 -> 이미지 안의 경로)
COPY app ./app
COPY data ./data

# 7. 이 컨테이너가 8000 포트를 사용한다고 적어 둔다.
#    기록일 뿐이다. 바깥에서 접속하려면 실행할 때 -p 옵션으로 포트를 연결해야 한다.
EXPOSE 8000

# 8. 컨테이너가 시작할 때 실행할 명령
#    0.0.0.0은 컨테이너 바깥에서 오는 요청도 받는다는 뜻이다.
ENTRYPOINT ["/app/.venv/bin/fastapi", "run"]
