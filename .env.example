# 이 파일을 복사해 같은 폴더에 .env로 저장한 뒤 값을 고친다. (.env는 Git에 올라가지 않는다)
# OPENAI_API_KEY는 Windows 사용자 환경 변수로 등록하는 것을 권한다. 여기에 적어도 동작은 한다.
# 키가 없으면 서버는 OpenAI 대신 가짜 LLM 클라이언트로 응답한다.

# 1. OpenAI Platform 관련 설정
OPENAI_MODEL=모델명
OPENAI_REASONING_EFFORT=추론 없음
OPENAI_MAX_OUTPUT_TOKENS=최대토큰상한
OPENAI_TIMEOUT_SECONDS=타임아웃(초)

# 2. 가짜 LLM 관련 설정 (OpenAI API 키가 없거나 FAKE_LLM=true일 때 사용)
# true면 OpenAI를 호출하지 않고 가짜 LLM 클라이언트를 사용한다. 비용 없이 시험하거나 성능을 잴 때 사용한다.
FAKE_LLM=false
# 가짜 LLM 클라이언트가 응답하기 전에 기다리는 시간(초). 차이를 눈으로 보려면 5 정도로 늘린다.
FAKE_LLM_DELAY_SECONDS=3

# 3. [실험용] def 핸들러(동기)를 실행할 스레드 풀의 작업 스레드 수.
# 아래 주석을 해제하면 적용되고, 해제하지 않으면 기본 40개가 적용된다.
# THREAD_POOL_SIZE=1
